{
  "name": "tramado",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:db": "node supabase/tests/migration.check.mjs",
    "gallery": "vite build --config vite.gallery.config.ts",
    "gallery:serve": "vite preview --config vite.gallery.config.ts --outDir dist-gallery --port 4180"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
