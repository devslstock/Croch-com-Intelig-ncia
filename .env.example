# Copie para .env.local (nunca commite chaves reais) e preencha com o projeto Supabase do Tramado.
# Em produção, cadastre as mesmas variáveis na Vercel (Settings > Environment Variables).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). NÃO use a service_role aqui.
VITE_SUPABASE_ANON_KEY=
# Opcional: mostra o botão "Continuar com o Google" (exige habilitar o Google no Supabase Auth).
VITE_GOOGLE_AUTH=false
# Opcionais: mostram os botões "Continuar com a Apple" e "Continuar com o WhatsApp" (exigem configurar no Supabase, veja supabase/README.md).
VITE_APPLE_AUTH=false
VITE_WHATSAPP_AUTH=false

# Bordado: limites do arquivo de foto (valores públicos, não são segredos). Padrões entre parênteses.
# VITE_EMB_MAX_MB=15            (tamanho máximo do arquivo, em MB)
# VITE_EMB_MAX_MEGAPIXELS=40    (máximo de pixels da foto, em milhões)
# VITE_EMB_MIN_SIDE=64          (menor lado aceito, em pixels)
